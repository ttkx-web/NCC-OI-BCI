name: bci-dayloop
channels:
  - pytorch
  - nvidia
  - conda-forge
dependencies:
  - python=3.11
  - pytorch>=2.1
  - pytorch-cuda=12.1
  - numpy>=1.26
  - scipy>=1.11
  - h5py>=3.10
  - pyyaml>=6.0
  - mne>=1.6
  - moabb>=1.1
  - scikit-learn>=1.4
  - pandas>=2.0
  - streamlit>=1.39
  - pytest>=8.0
  - pip

